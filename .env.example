# Player inquiry notifications (optional — without these, inquiries are still
# saved to data/inquiries.jsonl, just not emailed).
#
# RESEND_API_KEY: API key from https://resend.com — used to send an email
# notification whenever the contact form is submitted.
RESEND_API_KEY=

# INQUIRY_TO_EMAIL: where inquiry notifications get sent.
INQUIRY_TO_EMAIL=

# INQUIRY_FROM_EMAIL: the "from" address for those notifications. Must be a
# verified sender/domain in Resend. Defaults to Resend's onboarding sender
# if unset (fine for testing, not for production).
INQUIRY_FROM_EMAIL=

# PORT: port for the production server (server.js). Defaults to 8080.
PORT=8080
